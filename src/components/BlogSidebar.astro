---
/* Bio vem por slot (se não houver, usa um texto curto). Tags e arquivo por mês vêm de getCollection('blog').
   - No índice (noIndice): as tags são botões que filtram a lista ali mesmo e o arquivo pula para o mês.
   - Nas outras páginas (post): as tags viram links para o índice já filtrado (blog/?tag=…)
     e o arquivo leva ao mês no índice (blog/#m-AAAA-MM) — as âncoras só existem lá. */
import { getCollection } from "astro:content";
import { countTags, groupByMonth } from "@/lib/blog-utils";
import { withBase } from "@/lib/url";

interface Props {
  /** true só no índice do blog, onde existe o filtro de tags */
  noIndice?: boolean;
}
const { noIndice = false } = Astro.props;
const indice = withBase("blog/");

const entries = (await getCollection("blog")).sort(
  (a, b) => b.data.dataPublicacao.getTime() - a.data.dataPublicacao.getTime()
);

const tagsMap = countTags(entries);
const months = groupByMonth(entries);
---
<style>
  /* Painel da coxia: um pouco mais claro que a mesa, sem sombra (quem tem sombra é a ficha) */
  .box {
    padding: var(--oc-space-4);
    border: 1px solid var(--oc-border);
    border-radius: var(--oc-radius);
    background: var(--oc-painel);
  }
  .title {
    font-size: var(--oc-fs-lg);
    font-family: var(--oc-font-serif);
    color: var(--oc-titulo);
    margin-bottom: var(--oc-space-3);
  }
  .bio { color: var(--oc-muted); font-size: var(--oc-fs-sm); }
  .section { margin-top: var(--oc-space-6); }
  .taglist, .monthlist {
    display: flex; flex-wrap: wrap; gap: var(--oc-space-2);
  }
  /* as tags são etiquetas de arquivo (.oc-etiqueta, em base.css); aqui só o tamanho e o cursor */
  .tag {
    font-size: var(--oc-fs-xs);
    cursor: pointer;
    user-select: none;
  }
  .tag .counts { color: inherit; opacity: 0.7; }
  .monthlist a {
    font-size: var(--oc-fs-xs);
    border-bottom: 1px dotted var(--oc-border);
    padding-bottom: 1px;
  }
  .monthlist a:focus-visible {
    outline: 2px solid var(--oc-accent);
    outline-offset: 2px;
  }
  .counts { color: var(--oc-muted); font-size: var(--oc-fs-xs); }
</style>

<div class="box">
  <div class="title">Sobre</div>
  <div class="bio">
    <slot>Notas de bastidores da <strong>Oficina de Cientistas</strong>: decisões de design, arquitetura, componentes e diários de desenvolvimento.</slot>
  </div>

  <div class="section">
    <div class="title">Tags</div>
    <div class="taglist" id="oc-taglist">
      {Array.from(tagsMap.entries()).sort((a,b)=>a[0].localeCompare(b[0],'pt-BR')).map(([tag, n]) => (
        noIndice
          ? <button type="button" class="tag oc-etiqueta" data-tag={tag} aria-pressed="false">{tag} <span class="counts">({n})</span></button>
          : <a class="tag oc-etiqueta" href={`${indice}?tag=${encodeURIComponent(tag)}`}>{tag} <span class="counts">({n})</span></a>
      ))}
    </div>
  </div>

  <div class="section">
    <div class="title">Arquivo</div>
    <div class="monthlist">
      {months.map(m => (
        <a href={noIndice ? `#m-${m.ym}` : `${indice}#m-${m.ym}`} title={`${m.label} (${m.count})`}>{m.label} <span class="counts">({m.count})</span></a>
      ))}
    </div>
  </div>
</div>
