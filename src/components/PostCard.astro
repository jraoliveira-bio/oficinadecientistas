---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/blog-utils";
import { withBase } from "@/lib/url";

interface Props {
  post: CollectionEntry<"blog">;
  /** variante visual: "inline" quando o container externo já é a ficha (.oc-ficha) */
  variant?: "default" | "inline";
  /** nível do título: 3 no índice (abaixo do mês, que é h2) */
  nivel?: 2 | 3;
}

const { post, variant = "default", nivel = 2 } = Astro.props;

const href = withBase(`blog/${post.slug}/`);

const dateLabel = formatDate(post.data.dataPublicacao);
const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
const dataTags = tags.join(",").toLowerCase();

const titleId = `link-${post.slug}`;
const controlsId = `expand-${post.slug}`;
const Titulo = `h${nivel}`;
---

<style>
  /* Sozinho, o componente já vira uma ficha; dentro de .post-item.oc-ficha, só o miolo */
  .card { padding: var(--oc-space-4); }
  .inline { padding: var(--oc-space-4) var(--oc-space-4) 0; }

  .title {
    margin: 0 0 var(--oc-space-2);
    font-size: var(--oc-fs-1-5xl);
    line-height: 1.2;
  }
  .title a {
    color: var(--oc-titulo);
    text-decoration: none;
  }
  .title a:hover { text-decoration: underline; }
  .title a:focus-visible {
    outline: 2px solid var(--oc-accent);
    outline-offset: 2px;
  }

  /* Cabeçalho da ficha: carimbo + etiquetas, e a linha vermelha logo abaixo */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--oc-space-2) var(--oc-space-3);
    padding-bottom: var(--oc-space-3);
    margin-bottom: var(--oc-space-3);
  }
  .tags { display: inline-flex; gap: .4rem; flex-wrap: wrap; }

  .summary { margin: 0; padding-bottom: var(--oc-space-4); }
</style>

<article
  class:list={[
    "post-card",
    variant === "inline" ? "inline" : ["card", "oc-ficha"],
  ]}
  data-tags={dataTags}
  data-slug={post.slug}
>
  <Titulo class="title">
    <a
      href={href}
      id={titleId}
      data-behavior="expand-link"
      aria-controls={controlsId}
      aria-expanded="false"
    >
      {post.data.title}
    </a>
  </Titulo>

  <div class="meta oc-ficha-linha">
    <time class="oc-carimbo" datetime={post.data.dataPublicacao.toISOString().slice(0, 10)}>{dateLabel}</time>
    {tags.length > 0 && (
      <span class="tags">
        {tags.map((t) => <span class="oc-etiqueta">{t}</span>)}
      </span>
    )}
  </div>

  {post.data.summary && <p class="summary">{post.data.summary}</p>}
</article>
