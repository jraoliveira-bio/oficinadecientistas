---
// src/components/VideoPlayer.astro
// Player do YouTube + painel com abas "Tópicos" e "Transcrição" (tempos clicáveis).
// Pode haver mais de um por página: os ids são únicos por instância e um único
// <script> (o Astro o inclui uma vez só) inicializa todos os players.
interface Chapter {
  time: string;
  title: string;
}
interface TranscriptLine {
  time: string;
  text: string;
}
export interface Props {
  videoId: string;
  chapters: Chapter[];
  transcript: TranscriptLine[];
}
const { videoId, chapters = [], transcript = [] } = Astro.props;

const uid = `vp-${Math.random().toString(36).slice(2, 8)}`;
// aba que começa selecionada: Tópicos, se houver; senão Transcrição
const abaInicial = chapters.length > 0 ? 'topics' : 'transcript';
---

<div class="video-player-container" id={uid} data-video-id={videoId}>

  <div class="video-wrapper">
    <div class="yt-alvo"></div>
  </div>

  {/* O painel interativo inteiro só aparece se houver Tópicos OU Transcrição */}
  {(chapters.length > 0 || transcript.length > 0) && (
    <div class="interactive-panel">
      <div class="tab-nav" role="tablist" aria-label="Conteúdo do vídeo">

        {chapters.length > 0 && (
          <button
            type="button" role="tab" data-tab="topics"
            id={`${uid}-tab-topics`} aria-controls={`${uid}-panel-topics`}
            class:list={['tab-button', { active: abaInicial === 'topics' }]}
            aria-selected={abaInicial === 'topics' ? 'true' : 'false'}
            aria-expanded="false"
            tabindex={abaInicial === 'topics' ? 0 : -1}
          >
            Tópicos
            <span class="arrow-icon" aria-hidden="true"></span>
          </button>
        )}

        {transcript.length > 0 && (
          <button
            type="button" role="tab" data-tab="transcript"
            id={`${uid}-tab-transcript`} aria-controls={`${uid}-panel-transcript`}
            class:list={['tab-button', { active: abaInicial === 'transcript' }]}
            aria-selected={abaInicial === 'transcript' ? 'true' : 'false'}
            aria-expanded="false"
            tabindex={abaInicial === 'transcript' ? 0 : -1}
          >
            Transcrição
            <span class="arrow-icon" aria-hidden="true"></span>
          </button>
        )}
      </div>

      {/* Começa recolhido: inert tira os tempos do Tab enquanto estão invisíveis */}
      <div class="tab-content-panel" inert>

        {chapters.length > 0 && (
          <div
            id={`${uid}-panel-topics`} role="tabpanel" aria-labelledby={`${uid}-tab-topics`}
            data-panel="topics" class:list={['tab-pane', { active: abaInicial === 'topics' }]}
          >
            <ul class="content-list">
              {chapters.map((chapter) => (
                <li class="list-item">
                  <button type="button" class="timestamp-link" data-time={chapter.time} aria-label={`Ir para ${chapter.time} do vídeo`}>{chapter.time}</button>
                  <span class="text-content">{chapter.title}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {transcript.length > 0 && (
          <div
            id={`${uid}-panel-transcript`} role="tabpanel" aria-labelledby={`${uid}-tab-transcript`}
            data-panel="transcript" class:list={['tab-pane', { active: abaInicial === 'transcript' }]}
          >
            <div class="content-list">
              {transcript.map((line) => (
                <p class="list-item">
                  <button type="button" class="timestamp-link" data-time={line.time} aria-label={`Ir para ${line.time} do vídeo`}>{line.time}</button>
                  <span class="text-content">{line.text}</span>
                </p>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}
</div>

<style>
  .video-player-container {
    max-width: 800px;
    margin: 2rem auto;
    border: 1px solid var(--borda-escura);
    border-radius: var(--raio-m);
    background-color: var(--cor-bg-1);
    overflow: hidden;
    box-shadow: var(--sombra-1);
  }

  /* Player de Vídeo */
  .video-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background-color: var(--cor-tela);
  }
  /* :global — o <iframe> é criado em tempo de execução pela API do YouTube e não recebe o atributo de escopo */
  .video-wrapper :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Interface de Abas */
  .interactive-panel {
    border-top: 1px solid var(--borda-escura);
    padding: 0 1.5rem;
  }
  .tab-nav {
    display: flex;
    gap: 2rem;
    border-bottom: 1px solid var(--borda);
  }
  .tab-button {
    border: none; background: none; padding: 1rem 0.25rem; cursor: pointer;
    font-family: var(--fonte-ui);
    font-size: 1rem; font-weight: 600; color: var(--cor-texto-sec); position: relative;
    transition: color 0.3s ease;
  }
  .tab-button:hover { color: var(--cor-texto); }
  .tab-button::after {
    content: ''; position: absolute; bottom: -1px; left: 0;
    width: 100%; height: 3px; background-color: var(--cor-destaque);
    transform: scaleX(0); transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .tab-button.active { color: var(--cor-texto); }
  .tab-button.active::after { transform: scaleX(1); }
  .arrow-icon {
    display: inline-block; margin-left: 0.5rem; font-size: 0.7em;
    color: var(--cor-texto-suave); transition: transform 0.3s ease;
  }
  .tab-button .arrow-icon::before { content: '▼'; opacity: 0; transition: opacity 0.2s ease; }
  .tab-button.active .arrow-icon::before { opacity: 1; }
  .interactive-panel.panel-open .tab-button.active .arrow-icon { transform: rotate(180deg); }

  /* MUDANÇA 1: Animação de Abertura do Painel */
  .tab-content-panel {
    max-height: 0; /* Começa fechado */
    overflow: hidden; /* Esconde o conteúdo que transborda */
    transition: max-height 0.5s ease-in-out; /* Anima a altura */
  }
  .interactive-panel.panel-open .tab-content-panel {
    /* Define uma altura máxima para o estado aberto */
    /* Este valor deve ser grande o suficiente para o conteúdo. */
    /* A altura real será controlada pelo .content-list abaixo */
    max-height: 400px; 
  }

  .tab-pane { display: none; }
  .tab-pane.active { display: block; }

  /* MUDANÇA 2: Altura Máxima e Barra de Rolagem */
  .content-list {
    padding: 1.5rem 0.5rem 1.5rem 0; /* Adiciona padding para a barra de rolagem não colar no texto */
    margin: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 350px; /* A altura máxima real do conteúdo */
    overflow-y: auto; /* Barra de rolagem vertical aparece se necessário */
    position: relative;
  }

  .list-item {
    display: flex; align-items: baseline; gap: 1.5rem; margin: 0;
    padding: 0.5rem; border-radius: var(--raio-m); /* padding para o destaque */
    transition: background-color 0.3s ease; /* Anima a cor de fundo do destaque */
  }
  .list-item .timestamp-link {
    border: 0; cursor: pointer; /* é um <button> */
    flex-shrink: 0; width: 70px; font-family: var(--fonte-datilo);
    font-weight: bold; font-size: 0.95em; color: var(--cor-link);
    text-decoration: none; background-color: var(--cor-superficie-suave);
    padding: 4px 8px; border-radius: var(--raio-s); text-align: center;
    transition: background-color 0.2s ease;
  }
  .list-item .timestamp-link:hover { background-color: var(--cor-dica-fundo); }
  .tab-button:focus-visible,
  .list-item .timestamp-link:focus-visible {
    outline: 3px solid var(--cor-foco);
    outline-offset: 2px;
  }
  .list-item .text-content { line-height: 1.6; color: var(--cor-texto); }

  /* MUDANÇA 3: Estilo Visual do Destaque */
  .list-item.current {
    background-color: var(--cor-dica-fundo); /* item ativo */
  }
  .list-item.current .text-content {
    font-weight: 500; /* Deixa o texto do item ativo um pouco mais forte */
  }
</style>

<script>
  // Um só script para todos os players da página.
  const containers = Array.from(document.querySelectorAll('.video-player-container[data-video-id]'));
  const players = new WeakMap(); // container -> YT.Player

  function segundos(tempo) {
    const partes = tempo.split(':').map(Number);
    return partes.length === 3
      ? partes[0] * 3600 + partes[1] * 60 + partes[2]
      : partes[0] * 60 + partes[1];
  }

  // --- Abas e tempos clicáveis (funcionam antes mesmo de o vídeo carregar) ---
  function configurarPainel(container) {
    const painel = container.querySelector('.interactive-panel');
    if (!painel) return;
    const conteudo = painel.querySelector('.tab-content-panel');
    const abas = Array.from(painel.querySelectorAll('[role="tab"]'));

    function abrir(aberto) {
      painel.classList.toggle('panel-open', aberto);
      conteudo.inert = !aberto;
      abas.forEach(aba => aba.setAttribute('aria-expanded', String(aberto && aba.classList.contains('active'))));
    }

    function selecionar(aba) {
      abas.forEach(outra => {
        const ativa = outra === aba;
        outra.classList.toggle('active', ativa);
        outra.setAttribute('aria-selected', String(ativa));
        outra.tabIndex = ativa ? 0 : -1;
      });
      painel.querySelectorAll('.tab-pane').forEach(pane => {
        pane.classList.toggle('active', pane.dataset.panel === aba.dataset.tab);
      });
      abrir(true);
    }

    abas.forEach(aba => aba.addEventListener('click', () => {
      // clicar na aba já ativa abre/fecha o painel; clicar na outra troca e abre
      if (aba.classList.contains('active')) abrir(!painel.classList.contains('panel-open'));
      else selecionar(aba);
    }));

    // Setas ←/→ (e Home/End) movem entre as abas, como pede o padrão de abas do ARIA
    painel.querySelector('[role="tablist"]').addEventListener('keydown', (e) => {
      const i = abas.indexOf(document.activeElement);
      if (i < 0) return;
      let j = null;
      if (e.key === 'ArrowRight') j = (i + 1) % abas.length;
      if (e.key === 'ArrowLeft') j = (i - 1 + abas.length) % abas.length;
      if (e.key === 'Home') j = 0;
      if (e.key === 'End') j = abas.length - 1;
      if (j === null) return;
      e.preventDefault();
      abas[j].focus();
      selecionar(abas[j]);
    });

    painel.addEventListener('click', (e) => {
      const tempo = e.target.closest('.timestamp-link');
      if (!tempo) return;
      const player = players.get(container);
      if (player && typeof player.seekTo === 'function') {
        player.seekTo(segundos(tempo.dataset.time), true);
      }
    });
  }

  // --- Destaque do item correspondente ao ponto atual do vídeo ---
  function atualizarItemAtivo(container, player) {
    if (typeof player.getCurrentTime !== 'function') return;
    const agora = player.getCurrentTime();
    const pane = container.querySelector('.tab-pane.active');
    if (!pane) return;

    const itens = Array.from(pane.querySelectorAll('.list-item'));
    const rolagem = pane.querySelector('.content-list');
    let ativo = -1;
    itens.forEach((item, i) => {
      if (agora >= segundos(item.querySelector('.timestamp-link').dataset.time)) ativo = i;
    });

    itens.forEach((item, i) => {
      if (i !== ativo) { item.classList.remove('current'); return; }
      if (item.classList.contains('current')) return;
      item.classList.add('current');
      // rola só a lista (não a página) para centralizar o item ativo
      rolagem.scroll({
        top: item.offsetTop - rolagem.clientHeight / 2 + item.clientHeight / 2,
        behavior: 'smooth',
      });
    });
  }

  function criarPlayer(container) {
    let monitor = null;
    const player = new YT.Player(container.querySelector('.yt-alvo'), {
      height: '100%', width: '100%',
      videoId: container.dataset.videoId,
      host: 'https://www.youtube-nocookie.com',
      playerVars: { playsinline: 1, rel: 0 },
      events: {
        onStateChange(e) {
          // enquanto toca, confere o tempo 4x por segundo; parado, não gasta nada
          clearInterval(monitor);
          if (e.data === YT.PlayerState.PLAYING) {
            monitor = setInterval(() => atualizarItemAtivo(container, player), 250);
          }
        },
      },
    });
    players.set(container, player);
  }

  // --- API do YouTube: carregada uma vez, cria todos os players quando fica pronta ---
  function carregarApiDoYoutube(pronto) {
    if (window.YT && window.YT.Player) { pronto(); return; }
    const anterior = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = () => { anterior?.(); pronto(); };
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
  }

  containers.forEach(configurarPainel);
  const comVideo = containers.filter(c => c.dataset.videoId);
  if (comVideo.length) carregarApiDoYoutube(() => comVideo.forEach(criarPlayer));
</script>
