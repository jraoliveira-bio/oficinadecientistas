---
// src/components/BoxArtigo.astro

// A prop 'type' agora se chama 'palette' para refletir a intenção de design.
// O padrão será 'neutro'.
// Aceita `palette` (preferido) ou `type` (retrocompat). Valores desconhecidos caem em 'neutro'.
const { palette, type, title, imagem } = Astro.props;
const PALETAS = ['neutro', 'vermelho', 'roxo'];
const escolhida = palette ?? type ?? 'neutro';
const themeClass = `theme-${PALETAS.includes(escolhida) ? escolhida : 'neutro'}`;
---

<div class={`box-artigo-editorial ${themeClass}`}>
  
  {title && (
    <h3 class="box-artigo-titulo">{title}</h3>
  )}

  {imagem && (
    <figure class="box-artigo-figura">
      <img src={imagem} alt={title || 'Imagem de destaque do artigo'} />
      {Astro.slots.has('legenda') && (
        <figcaption>
          <slot name="legenda" />
        </figcaption>
      )}
    </figure>
  )}

  <div class="box-artigo-conteudo">
    <div class="coluna">
      <slot name="coluna-esquerda" />
    </div>
    <div class="coluna">
      <slot name="coluna-direita" />
    </div>
  </div>

</div>

<style>
  .box-artigo-editorial {
    margin: 40px 0;
    padding: 25px 30px;
    border-radius: var(--raio-s);

    /* ESTILO NOVO: Bordas duplas verticais */
    border-left: 3px solid;
    border-right: 3px solid;

    /* Borda superior e inferior muito sutis para fechar o quadro */
    border-top: 1px solid var(--borda);
    border-bottom: 1px solid var(--borda);

    box-shadow: var(--sombra-1);
  }

  .box-artigo-titulo {
    margin-top: 0;
    margin-bottom: 20px;
    font-size: 20px;
    font-weight: 600;
  }

  .box-artigo-figura {
    margin: 0 0 20px 0;
    text-align: center;
  }
  .box-artigo-figura img {
    max-width: 100%;
    height: auto;
    border-radius: var(--raio-s);
    margin-bottom: 10px;
  }
  .box-artigo-figura figcaption {
    font-size: 15px;
    font-style: italic;
    color: var(--cor-texto-sec);
  }

  .box-artigo-conteudo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }

  .coluna :global(p) {
    margin-top: 0;
    line-height: 1.7;
  }

  /* --- PALETAS DE COR --- */
  /* Cores vêm dos papéis --cor-box-* e --cor-neutro (public/estilos.css) */
  .theme-vermelho {
    border-color: var(--cor-box-vermelho-borda);
    background-color: color-mix(in srgb, var(--cor-box-vermelho-borda) 7%, white);
  }
  .theme-vermelho .box-artigo-titulo { color: var(--cor-box-vermelho); }

  .theme-roxo {
    border-color: var(--cor-box-roxo-borda);
    background-color: color-mix(in srgb, var(--cor-box-roxo-borda) 10%, white);
  }
  .theme-roxo .box-artigo-titulo { color: var(--cor-box-roxo); }

  .theme-neutro {
    border-color: color-mix(in srgb, var(--cor-neutro) 30%, white);
    background-color: var(--cor-neutro-fundo);
  }
  .theme-neutro .box-artigo-titulo { color: var(--cor-neutro); }

  /* --- RESPONSIVIDADE --- */
  @media (max-width: 768px) {
    .box-artigo-conteudo {
      grid-template-columns: 1fr; /* Uma coluna só no mobile */
    }
  }
</style>