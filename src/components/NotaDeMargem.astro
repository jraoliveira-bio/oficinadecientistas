---
/**
 * Componente: NotaDeMargem
 * Uso: "embrulhar" (wrap) um parágrafo e exibir uma nota curta na margem.
 *
 * Props:
 * - resumo (string)         -> texto curto que aparece na margem (obrigatório)
 * - lado ('direita'|'esquerda') -> lado da margem em tela larga, ≥1280px (default: 'direita').
 *     Em telas menores a nota vira um bloco acima do parágrafo. Use 'direita':
 *     à esquerda fica o menu de aulas, então lá a nota só aparece no "Modo leitura".
 * - cor (nome da paleta|cor CSS) -> cor do texto/realce da nota (default: 'jade').
 *     Nomes aceitos: os de src/styles/paleta.css (jade, vinho, ardosia, tinta, salvia…).
 * - largura (CSS length)    -> largura da caixa da nota (default: '18ch')
 * - offset (CSS length)     -> distância entre o texto e a nota (default: '1.5rem')
 * - icone (string)          -> opcional; ícone da nota (default: '✎')
 */

interface Props {
  resumo: string;
  lado?: 'direita' | 'esquerda';
  cor?: 'jade' | 'vinho' | string;
  largura?: string;
  offset?: string;
  icone?: string;
}

const {
  resumo,
  lado = 'direita',
  cor = 'jade',
  largura = '18ch',
  offset = '1.5rem',
  icone = '✎',
} = Astro.props;

// Nome da paleta (ex.: 'jade') vira var(--jade); qualquer outra cor CSS passa direto.
const TINTAS = ['tinta', 'ardosia', 'grafite', 'vinho', 'vinho-escuro', 'jade', 'salvia', 'ameixa', 'terracota', 'ocre'];
const corCss = TINTAS.includes(cor) ? `var(--${cor})` : cor;

// Fundo suave do bloco (telas estreitas/médias): a própria cor da nota, bem diluída no branco
const fundo = `color-mix(in srgb, ${corCss} 9%, white)`;
---

<!--
  Estrutura:
  - wrapper: posicionamento relativo
  - .nota   : posição absoluta que "sangra" para fora da coluna no desktop
  - .conteudo: mantém fluxo normal do parágrafo/slot
-->
<div
  class="nota-de-margem"
  data-lado={lado}
  style={`--nota-largura:${largura}; --nota-cor:${corCss}; --nota-offset:${offset}; --nota-fundo:${fundo};`}
>
  <aside class="nota" role="note" aria-label="Nota de margem">
    <span class="icone" aria-hidden="true">{icone}</span>
    <span class="texto">{resumo}</span>
  </aside>

  <div class="conteudo">
    <slot />
  </div>
</div>

<style>
  /* Mobile-first: a nota é um bloco destacado acima do parágrafo.
     Só em tela larga (≥1280px) ela "sangra" para a margem — o AulaLayout reserva
     uma coluna de margem à direita quando a aula tem notas desse lado. */
  .nota-de-margem {
    position: relative;
    overflow: visible; /* permite "sangrar" a anotação para fora */
  }

  .conteudo {
    position: relative;
    z-index: 0;
    display: flow-root; /* cria BFC e segura a margin-top do 1º filho */
  }

  .nota {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0 0 0.6rem 0;
    padding: 0.5rem 0.75rem;
    border-left: 0.28rem solid var(--nota-cor);
    border-radius: var(--raio-m);
    background: var(--nota-fundo);
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--nota-cor);
    text-align: left;
    user-select: text;
    text-wrap: balance;
  }

  .nota .icone {
    flex: 0 0 auto;
    transform: translateY(-0.05em);
  }
  .nota .icone:empty { display: none; } /* icone="" não deixa espaço sobrando */

  /* Acessibilidade: mantêm contraste em temas muito claros */
  @media (prefers-contrast: more) {
    .nota { text-decoration-thickness: 0.08em; }
  }

  /* Tela larga: a nota vai para a margem, ao lado do parágrafo */
  @media (min-width: 1280px) {
    .nota {
      display: block;
      position: absolute;
      top: 1.5rem;      /* alinha ao topo do conteúdo */
      /* nunca mais larga que a coluna de margem reservada pelo AulaLayout */
      width: min(var(--nota-largura), calc(var(--margem-notas, 14rem) - var(--nota-offset)));
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      font-size: 0.9rem; /* menor que o corpo do texto */
      line-height: 1.2;
      z-index: 1;
    }

    .nota .icone {
      display: inline-block;
      margin-right: 0.25rem;
    }

    /* Leve sensação "manual": a nota fica um pouco torta, como anotada a lápis */
    .nota-de-margem[data-lado="direita"] .nota {
      left: 100%;
      margin-left: var(--nota-offset);
      transform: rotate(1deg);
      text-align: left;
    }

    .nota-de-margem[data-lado="esquerda"] .nota {
      right: 100%;
      margin-right: var(--nota-offset);
      transform: rotate(-1deg);
      text-align: right;
    }
  }
</style>
