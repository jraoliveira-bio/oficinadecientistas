---
import FeatureHeroCard from "./FeatureHeroCard.astro";

interface Hero {
  href: string;
  imgSrc: string;
  imgAlt: string;
  label?: string;
  title: string;
  description?: string;
  meta?: string;
  cta?: string;
}

interface Props {
  hero: Hero;
}

// O blog saiu daqui: agora é o painel "Da Prancheta" (HomePrancheta), com os últimos posts
const { hero } = Astro.props;
---

<section class="home-featured" aria-label="Curso em destaque">
  <FeatureHeroCard {...hero} />
</section>

<style>
  .home-featured {
    max-width: 1280px;
    margin: 60px auto;
    padding: 0 40px;
    display: grid;
    gap: 1.6rem;
  }

  @media (max-width: 900px) {
    .home-featured {
      padding: 0 20px;
      margin: 40px auto;
    }
  }
</style>
