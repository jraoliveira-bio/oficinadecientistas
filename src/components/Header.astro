---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const links = [
  { href: base, texto: 'Home' },
  { href: `${base}cursos/`, texto: 'Cursos' },
  { href: `${base}aulas-especiais/`, texto: 'Aulas Especiais' },
  { href: `${base}sobre/`, texto: 'Sobre' },
  { href: `${base}links/`, texto: 'Links' },
];

// Link da página atual: "page" quando é a própria página; "true" quando é uma página dentro
// da seção (ex.: uma aula está dentro de "Cursos"). A Home só conta na própria Home.
const caminho = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
function atual(href) {
  if (caminho === href) return 'page';
  if (href !== base && caminho.startsWith(href)) return 'true';
  return undefined;
}
---
<header class="topo">
    <div class="topo-conteudo">
      <a class="logo-titulo-wrapper" href={base}>
        <img src={`${base}logo2.png`} alt="" class="logo-header">
        <span class="marca-nome">Oficina de Cientistas</span>
      </a>
      <!-- Hambúrguer (só aparece no mobile): botão de verdade, com estado em aria-expanded -->
      <button
        type="button"
        class="menu-hamburger"
        aria-controls="menu-principal"
        aria-expanded="false"
        aria-label="Abrir menu"
      >
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav class="menu-principal" id="menu-principal" aria-label="Principal">
        <ul>
          {links.map(({ href, texto }) => (
            <li><a href={href} aria-current={atual(href)}>{texto}</a></li>
          ))}
        </ul>
      </nav>
    </div>
</header>

<script>
  // Menu do mobile: abre/fecha pelo botão, fecha com Esc (devolvendo o foco ao botão)
  // e ao escolher um link.
  const botao = document.querySelector('.menu-hamburger');
  const menu = document.getElementById('menu-principal');

  if (botao && menu) {
    const definir = (aberto) => {
      botao.setAttribute('aria-expanded', String(aberto));
      botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    };

    botao.addEventListener('click', () => {
      definir(botao.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && botao.getAttribute('aria-expanded') === 'true') {
        definir(false);
        botao.focus();
      }
    });

    menu.addEventListener('click', (e) => {
      if (e.target.closest('a')) definir(false);
    });
  }
</script>
