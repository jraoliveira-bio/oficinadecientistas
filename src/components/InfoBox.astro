---
// src/components/InfoBox.astro

// 1. RECEBENDO AS "INSTRUÇÕES" (PROPS)
// Aqui, pegamos as propriedades 'type' e 'title' que serão passadas para o componente.
// Definimos 'saiba-mais' como o tipo padrão se nenhum for fornecido.
const { type = 'saiba-mais', title } = Astro.props;

// 2. MAPA DE ESTILOS
// Em vez de if/else, criamos um "mapa" para associar cada tipo ao seu ícone e classe de cor.
const styleMap = {
  dica: {
    iconClass: 'fa-solid fa-lightbulb',
    colorClass: 'info-box-dica'
  },
  atencao: {
    iconClass: 'fa-solid fa-triangle-exclamation',
    colorClass: 'info-box-atencao'
  },
  'saiba-mais': {
    iconClass: 'fa-solid fa-book-reader',
    colorClass: 'info-box-saiba-mais'
  },
   'chave': {
    iconClass: 'fa-solid fa-key',
    colorClass: 'info-box-chave'
  }
};

// Tipo desconhecido cai em 'saiba-mais' (antes quebrava o build)
const currentStyle = styleMap[type] ?? styleMap['saiba-mais'];
---

<div class={`info-box ${currentStyle.colorClass}`}>
  
  {title && (
    <h3 class="info-box-titulo">
      <i class={currentStyle.iconClass} aria-hidden="true"></i>
      {title}
    </h3>
  )}

  <div class="info-box-conteudo">
    <slot />
  </div>

</div>


<style>
  /* --- ESTILO BASE DA CAIXA EDITORIAL --- */
  .info-box {
    margin: 30px 0;
    padding: 20px 25px;
    border-radius: var(--raio-m);


    /* 2. Borda fina para dar definição */
    border: 1px solid color-mix(in srgb, var(--cor-neutro) 40%, white);
    
    /* Borda esquerda mais grossa, que será colorida pelas variações */
    border-left-width: 4px;
    border-left-style: solid;

    /* 3. Sombra muito suave para dar profundidade */
    box-shadow: var(--sombra-1);

    transition: all 0.3s ease-out;
  }

  .info-box:hover {
    transform: translateY(-3px);
    box-shadow: var(--sombra-2);
  }

  .info-box-titulo {
    margin-top: 0;
    margin-bottom: 15px;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .info-box-conteudo :global(p) {
    margin-bottom: 0;
    font-family: var(--fonte-ui); /* antes 'Bitter', que nunca era carregada */
    line-height: 1.7;
    color: var(--cor-texto);
  }

  .info-box-conteudo :global(p:not(:last-child)) {
    margin-bottom: 1rem;
  }


/* --- VARIAÇÕES DE COR - OPÇÃO 2: PALETA EDITORIAL --- */

/* Variação: Dica */
.info-box-dica {
  background-color: var(--cor-dica-fundo);
  border-left-color: var(--cor-dica);
}
.info-box-dica .info-box-titulo {
  color: var(--cor-dica);
}

/* Variação: Atenção (com a nova paleta vermelho-vinho) */
.info-box-atencao {
  background-color: var(--cor-atencao-fundo);
  border-left-color: var(--cor-atencao);
}
.info-box-atencao .info-box-titulo {
  color: var(--cor-atencao);
}

/* Variação: Saiba Mais */
.info-box-saiba-mais {
  background-color: var(--cor-neutro-fundo);
  border-left-color: var(--cor-neutro);
}
.info-box-saiba-mais .info-box-titulo {
  color: var(--cor-neutro);
}

/* NOVA VARIAÇÃO: Conceito-Chave */
.info-box-chave {
  background-color: var(--cor-conceito-fundo);
  border-left-color: var(--cor-conceito);
}
.info-box-chave .info-box-titulo {
  color: var(--cor-conceito);
}
</style>