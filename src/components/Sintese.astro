---
// src/components/Sintese.astro
---
<section class="caixa-sintese">
  <h3 class="sintese-titulo">
    Síntese
  </h3>
  <div class="sintese-conteudo">
    <slot />
  </div>
</section>

<style>
  .caixa-sintese {
    margin: 60px auto;
    padding: 25px 30px;
    border-radius: var(--raio-m);
    border: 1px solid color-mix(in srgb, var(--cor-neutro) 30%, white);
    background-color: var(--cor-neutro-fundo);
    max-width: 900px;
    box-shadow: var(--sombra-1);
  }

  .sintese-titulo {
    margin-top: 0;
    margin-bottom: 20px;
    font-size: 20px;
    font-weight: 600;
    color: var(--cor-neutro);
    border-bottom: 1px solid var(--borda-escura);
    padding-bottom: 15px;
    /* Alterações aqui 👇 */
    text-align: center; 
  }

  .sintese-conteudo :global(p) {
    margin: 0;
    line-height: 1.7;
    font-family: var(--fonte-base);
  }
  
  .sintese-conteudo :global(.take-home-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
</style>