---
// src/components/Sintese.astro
---
<section class="caixa-sintese">
  <h3 class="sintese-titulo">
    Síntese
  </h3>
  <div class="sintese-conteudo">
    <slot />
  </div>
</section>

<style>
  /* Base comum das caixas (D6: --caixa-*, em public/estilos.css).
     O traço próprio da Síntese é o título em versalete vinho, centrado sobre um filete. */
  .caixa-sintese {
    margin: 60px auto;
    padding: var(--caixa-respiro);
    border: var(--caixa-filete);
    border-radius: var(--caixa-raio);
    background: var(--caixa-fundo);
    max-width: 900px;
  }

  .sintese-titulo {
    margin-top: 0;
    margin-bottom: 20px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cor-destaque);
    border-bottom: 1px solid var(--borda-escura);
    padding-bottom: 12px;
    text-align: center;
  }

  .sintese-conteudo :global(p) {
    margin: 0;
    line-height: 1.7;
    font-family: var(--fonte-base);
  }
  
  .sintese-conteudo :global(.take-home-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
</style>