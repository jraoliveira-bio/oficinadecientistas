---
/* Blog layout próprio (sem herdar Layout.astro):
   - SEO básico via props title/description
   - slots: header / sidebar / head
   - tokens/base importados só aqui para não vazar ao site-mãe
*/
import "@/styles/paleta.css"; // tintas nomeadas, compartilhadas com o site
import "@/styles/tokens.css";
import "@/styles/base.css";
import { withBase } from "@/lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "A Prancheta — bastidores da Oficina de Cientistas",
  description = "Bastidores, decisões de design e notas de laboratório do projeto Oficina de Cientistas.",
} = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{title}</title>
    <!-- Site NÃO-LISTADO (alfa): acessível pelo link, mas buscadores não indexam nem seguem links.
         Para listar publicamente no futuro, apague esta linha aqui e no outro layout
         (Layout.astro e BlogLayout.astro). -->
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content={description} />

    <!-- OG/Twitter básicos -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicons exclusivos do blog -->
    <link rel="icon" href={withBase("img/favicons/blog.ico")} sizes="any">
    <link rel="icon" href={withBase("img/favicons/blog-32x32.png")} sizes="32x32" type="image/png">
    <link rel="icon" href={withBase("img/favicons/blog-16x16.png")} sizes="16x16" type="image/png">
    <link rel="icon" href={withBase("img/favicons/blogandroid-chrome-192x192.png")} sizes="192x192" type="image/png">
    <link rel="apple-touch-icon" href={withBase("img/favicons/blog-apple-touch-icon.png")}>
<meta name="theme-color" content="#683636">

    <!-- Fontes num único pedido — as mesmas famílias do site (o espelho troca cores, não letras):
         Lato (texto, --oc-font-sans), Lora (títulos e botão, --oc-font-serif) e
         Montserrat 200 (título do header, que rima com o slogan da home) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Lora:wght@400;700&family=Montserrat:wght@200&display=swap" rel="stylesheet">

    <!-- Feed RSS (src/pages/blog/rss.xml.js): leitores de feed acham sozinhos por aqui -->
    <link rel="alternate" type="application/rss+xml" title="A Prancheta" href={withBase("blog/rss.xml")} />

    <!-- Slot extra para páginas poderem injetar <head> -->
    <slot name="head" />

    <style>
      :global(.oc-container){
        max-width: var(--oc-maxw);
        margin: 0 auto;
        /* topo 0; laterais padrão; base com respiro */
        padding: 0 var(--oc-space-4) var(--oc-space-6);
      }
      :global(.oc-grid){
        display: grid;
        grid-template-columns: minmax(0, var(--oc-colw-main)) minmax(260px, var(--oc-colw-aside));
        gap: var(--oc-space-8);
        align-items: start;
      }
      @media (max-width: 900px){
        :global(.oc-grid){ grid-template-columns: 1fr; }
      }
      :global(.oc-main){ min-width: 0; }
      :global(.oc-aside){
        position: sticky;
        top: var(--oc-space-6); /* ajuste se quiser colar mais/menos abaixo do header */
        align-self: start;
      }
      :global(.oc-card){
        background: var(--oc-card);
        border: 1px solid var(--oc-border);
        border-radius: var(--oc-radius);
        box-shadow: var(--oc-shadow-1);
      }
      /* Rodapé: rima com o do site (filete em cima, centralizado, discreto) */
      .oc-rodape {
        margin-top: var(--oc-space-12);
        padding: var(--oc-space-6) 0 var(--oc-space-2);
        border-top: 1px solid color-mix(in srgb, var(--oc-fg) 15%, transparent);
        text-align: center;
        font-size: var(--oc-fs-xs);
        color: var(--oc-muted);
      }
      .oc-rodape p { margin: 0 0 var(--oc-space-2); }
      .oc-rodape a { text-decoration: underline; }
    </style>
  </head>
  <body>
    <!-- Header fora do contêiner: faixa de ponta a ponta, como no site (o espelho rima) -->
    <slot name="header" />
    <div class="oc-container">
      <div class="oc-grid" style="margin-top: var(--oc-space-6);">
        <main class="oc-main">
          <slot />
        </main>
        <aside class="oc-aside">
          <slot name="sidebar" />
        </aside>
      </div>
      <footer class="oc-rodape">
        <p>A Prancheta: os bastidores da <a href={withBase("")}>Oficina de Cientistas</a>.</p>
        <p><a href={withBase("blog/")}>Todos os posts</a> · <a href={withBase("blog/rss.xml")}>Assinar pelo RSS</a></p>
      </footer>
    </div>
  </body>
</html>
