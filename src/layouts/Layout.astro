---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import "../styles/paleta.css"; // tintas nomeadas; os papéis ficam em public/estilos.css

const DESCRICAO_PADRAO = 'Cursos gratuitos de formação científica para pós-graduandos — começando pela escrita científica.';
const { title, description = DESCRICAO_PADRAO } = Astro.props;

// Lógica segura que garante que a base sempre termine com uma barra
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - Oficina de Cientistas</title>
    <meta name="description" content={description}>
    <!-- Prévia do link quando compartilhado (WhatsApp, redes etc.) -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Oficina de Cientistas">
    <meta property="og:title" content={`${title} - Oficina de Cientistas`}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
    <meta property="og:image" content={new URL(`${base}logo1.png`, Astro.site)}>
    <meta property="og:locale" content="pt_BR">
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
    <!-- Site NÃO-LISTADO (alfa): acessível pelo link, mas buscadores não indexam nem seguem links.
         Para listar publicamente no futuro, apague esta linha aqui e no outro layout
         (Layout.astro e BlogLayout.astro). -->
    <meta name="robots" content="noindex, nofollow">
    <script is:inline>
  (function () {
    try {
      const root = document.documentElement; // <html>
      // aceita '1' ou 'true' (legado)
      const v = localStorage.getItem('oficina.modoLeitura');
      const on = v === '1' || v === 'true';
      if (on) root.classList.add('modo-leitura-ativo', 'modo-leitura-handle-pronto');
    } catch (e) {}
  })();
</script>
    <link rel="stylesheet" href={`${base}estilos.css`}>
    <link rel="icon" type="image/png" href={`${base}favicon-96x96.png`} sizes="96x96" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
    <link rel="manifest" href={`${base}site.webmanifest`}>

    <!-- Ícones (FontAwesome 6, versão estável — antes era um beta) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <!-- Fontes num único pedido: Lora (títulos), Source Sans Pro (texto das aulas), Lato (base),
         Special Elite + Courier Prime (máquina de escrever), Montserrat (slogan da home) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@700&family=Source+Sans+Pro:wght@400;600&family=Lato:wght@400;700&family=Special+Elite&family=Courier+Prime&family=Montserrat:wght@300&display=swap" rel="stylesheet">
</head>
<body>
    <script is:inline>
      // Restaura o "modo leitura" no <body> antes do 1º paint (evita flash ao recarregar).
      // Precisa rodar aqui dentro do <body>: o preload do <head> só alcança o <html>.
      (function () {
        try {
          var v = localStorage.getItem('oficina.modoLeitura');
          if (v === '1' || v === 'true') {
            document.body.classList.add('modo-leitura-ativo', 'modo-leitura-handle-pronto');
          }
        } catch (e) {}
      })();
    </script>
    <div class="pagina-container">
        <Header />
        <slot />
        <Footer />
    </div>

    <script>
        const yearSpan = document.getElementById('currentYear');
        if (yearSpan) {
            yearSpan.textContent = new Date().getFullYear();
        }
    </script>
</body>
</html>