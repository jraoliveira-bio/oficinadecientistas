---
// src/layouts/AulaLayout.astro
import { getCollection } from 'astro:content';
import Layout from '~/layouts/Layout.astro'; // Importa o layout principal
import { tempoDeLeitura } from '~/lib/tempo-leitura';

// Garante o CSS das citações e o script de hidratação
import hydrateUrl from '../scripts/citations-hydrate.js?url';
import "../styles/citations.css";

// Recebe a 'aulaAtual' que foi passada pelo [slug].astro
const { aulaAtual } = Astro.props;
const referencias = aulaAtual?.data?.references ?? [];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

// Serializa as referências para um atributo de dados, evitando bugs do compilador Astro
const refsAttr = encodeURIComponent(JSON.stringify(referencias));

// Busca todas as aulas da coleção para montar o menu
// Rascunhos (draft: true) aparecem no `npm run dev`, mas ficam fora do site publicado
const todasAsAulas = (await getCollection('curso-escrita'))
  .filter(aula => aula.data.menu === true && (import.meta.env.DEV || !aula.data.draft))
  .sort((a, b) => (a.data.ordem ?? 999) - (b.data.ordem ?? 999));

const urlDaAula = (aula) => `${base}cursos/curso-escrita/${aula.slug}/`;

// Aula anterior/próxima, na mesma ordem do menu (rascunho fora do menu não tem vizinhas)
const posicao = todasAsAulas.findIndex(aula => aula.slug === aulaAtual.slug);
const anterior = posicao > 0 ? todasAsAulas[posicao - 1] : null;
const proxima = posicao >= 0 && posicao < todasAsAulas.length - 1 ? todasAsAulas[posicao + 1] : null;

// Linha sob o título: "Aula 01 · com vídeo · ~12 min de leitura"
const ordem = aulaAtual.data.ordem;
const metaAula = [
  ordem >= 1 ? `Aula ${String(ordem).padStart(2, '0')}` : null,
  aulaAtual.data.tipo === 'video' ? 'com vídeo' : null,
  `~${tempoDeLeitura(aulaAtual.body)} min de leitura`,
].filter(Boolean).join(' · ');
---

<Layout title={aulaAtual.data.title} description={aulaAtual.data.description}>
  <script is:inline>
    // Desliga transições no 1º paint (o estado do modo leitura já foi restaurado pelo Layout)
    document.body.classList.add('ml-preload');
  </script>
  <main class="container-sala-de-aula">
    <aside class="menu-aulas">
      <button
        id="toggle-leitura"
        class="toggle-leitura"
        data-leitura-toggle
        aria-pressed="false"
        aria-label="Ativar modo leitura"
        title="Modo leitura"
        type="button"
      >
        <span class="icone" aria-hidden="true">⫷</span>
        <span class="texto">Modo leitura</span>
      </button>

      <h3>Escrita Científica</h3>
      {/* Índice do curso: sempre aberto no desktop (o <summary> some); no celular começa
          recolhido para não ocupar a primeira tela inteira. Sem JS, fica aberto. */}
      <details class="indice-curso" open>
        <summary>
          Índice do curso
          {posicao >= 0 && <span class="indice-posicao">aula {posicao + 1} de {todasAsAulas.length}</span>}
        </summary>
      <ol>
        {todasAsAulas.map(aula => {
          const aulaUrl = urlDaAula(aula);
          const isAtiva = aula.slug === aulaAtual.slug;

          // --- LÓGICA DO ÍCONE ---
          // Se o tipo for texto, usa "pena de escrita". Se não, usa vídeo.
          const iconeClasse = aula.data.tipo === 'texto' ? 'fas fa-align-left' : 'fas fa-video';
          // -----------------------

          return (
            <li class:list={[{'aula-ativa': isAtiva}]}>
              <a href={aulaUrl} aria-current={isAtiva ? 'page' : undefined}>
                <i class={iconeClasse} aria-hidden="true"></i> {aula.data.shortTitle ?? aula.data.title}
              </a>
            </li>
          )
        })}
      </ol>
      </details>
      <script is:inline>
        (function () {
          var indice = document.currentScript.previousElementSibling;
          var celular = window.matchMedia('(max-width: 768px)');
          function ajustar() { indice.open = !celular.matches; }
          ajustar();
          celular.addEventListener('change', ajustar);
        })();
      </script>
    </aside>

    <button
      class="handle-leitura"
      data-leitura-toggle
      aria-label="Reabrir menu"
      title="Reabrir menu"
      type="button"
    >
      <span class="icone" aria-hidden="true">⫸</span>
    </button>

    <div class="conteudo-aula">
      <article class="texto-aula">
        <h1 class="titulo-pagina-aula">{aulaAtual.data.title}</h1>
        <p class="meta-aula">{metaAula}</p>
        <slot />

        {(anterior || proxima) && (
          <nav class="navegacao-aulas" aria-label="Navegação entre aulas">
            {anterior && (
              <a class="nav-aula anterior" href={urlDaAula(anterior)} rel="prev">
                <span class="nav-rotulo">← Aula anterior</span>
                <span class="nav-titulo">{anterior.data.title}</span>
              </a>
            )}
            {proxima && (
              <a class="nav-aula proxima" href={urlDaAula(proxima)} rel="next">
                <span class="nav-rotulo">Próxima aula →</span>
                <span class="nav-titulo">{proxima.data.title}</span>
              </a>
            )}
          </nav>
        )}

        {/* Dados das referências embutidos de forma segura em uma tag <meta> */}
        <meta id="oc-refs" data-refs={refsAttr} />
        {/* Script único das citações: numera os <Cite/>, cria os popovers e monta a <ReferenceList/> */}
        <script type="module" src={hydrateUrl}></script>

      </article>
    </div>
  </main>

<!-- Script para a funcionalidade do "Modo Leitura" -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const LS_KEY   = 'oficina.modoLeitura';
      const ROOT     = document.documentElement;
      const BODY     = document.body;
      const container = document.querySelector('.container-sala-de-aula');
      const menu      = document.querySelector('.menu-aulas');
      const menuBtn   = document.querySelector('.menu-aulas .toggle-leitura');
      const toggles   = Array.from(document.querySelectorAll('[data-leitura-toggle], #toggle-leitura, .toggle-leitura, .handle-leitura'));

      if (!container || !menu || !toggles.length) {
        BODY.classList.remove('ml-preload');
        return;
      }

      function setPressed(active) {
        for (const btn of toggles) {
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          const isHandle = btn.classList.contains('handle-leitura');
          const label = active ? 'Sair do modo leitura' : (isHandle ? 'Reabrir menu' : 'Ativar modo leitura');
          btn.setAttribute('aria-label', label);
          btn.title = label;
        }
      }

      function placeHandleAnchored() {
        if (menuBtn) {
          const rTop = menuBtn.getBoundingClientRect();
          ROOT.style.setProperty('--handle-top', `${Math.max(8, Math.round(rTop.top))}px`);
        }
        const rLeft = container.getBoundingClientRect();
        ROOT.style.setProperty('--handle-left', `${Math.max(8, Math.round(rLeft.left))}px`);
      }

      function revealHandleAfterMenuSlidesOut() {
        const fallback = setTimeout(() => {
          ROOT.classList.add('modo-leitura-handle-pronto');
          BODY.classList.add('modo-leitura-handle-pronto');
        }, 550);
        function onEnd(e) {
          if (e.propertyName !== 'transform') return;
          clearTimeout(fallback);
          menu.removeEventListener('transitionend', onEnd);
          ROOT.classList.add('modo-leitura-handle-pronto');
          BODY.classList.add('modo-leitura-handle-pronto');
        }
        menu.addEventListener('transitionend', onEnd, { once: true });
      }

      function syncClasses(active) {
        [ROOT, BODY].forEach(el => {
          el.classList.toggle('modo-leitura-ativo', active);
          if (!active) el.classList.remove('modo-leitura-handle-pronto');
        });
      }

      const startActive = ROOT.classList.contains('modo-leitura-ativo');
      if (startActive) {
        placeHandleAnchored();
        setPressed(true);
      } else {
        setPressed(false);
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          BODY.classList.remove('ml-preload');
        });
      });

      toggles.forEach(btn => btn.addEventListener('click', () => {
        const next = !ROOT.classList.contains('modo-leitura-ativo');
        syncClasses(next);
        setPressed(next);
        localStorage.setItem(LS_KEY, next ? '1' : '0');

        if (next) {
          placeHandleAnchored();
          revealHandleAfterMenuSlidesOut();
        }
      }));

      window.addEventListener('resize', () => {
        if (ROOT.classList.contains('modo-leitura-ativo')) placeHandleAnchored();
      }, { passive: true });

      const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (mq.matches) {
        toggles.forEach(btn => {
          btn.addEventListener('click', () => {
            if (ROOT.classList.contains('modo-leitura-ativo')) {
              ROOT.classList.add('modo-leitura-handle-pronto');
              BODY.classList.add('modo-leitura-handle-pronto');
            }
          });
        });
      }
    });
  </script>
</Layout>

<style>
  :root {
    --t: 0.5s;
    --easing: ease-in-out;
    --gap-sala: 1.5rem;
    --menu-largura: 320px;
    --conteudo-max-padrao: 70ch;
    --conteudo-max: 65ch;
    --conteudo-pad: clamp(1rem, 2vw, 2rem);
    --handle-top: .5rem;
    --handle-left: .5rem;
  }
  .container-sala-de-aula {
    display: grid;
    grid-template-columns: var(--menu-largura) 1fr;
    gap: var(--gap-sala);
    padding: 40px;
    align-items: start;
    transition: grid-template-columns var(--t) var(--easing);
  }
  .menu-aulas {
    position: sticky;
    top: 0.5rem;
    align-self: start;
    height: max-content;
    transform: translateX(0);
    transition: transform var(--t) var(--easing);
    will-change: transform;
    overflow: hidden;
    z-index: 2;
  }
  .conteudo-aula {
    min-width: 0;
    transition: padding var(--t) var(--easing), margin var(--t) var(--easing);
  }
  .texto-aula {
    margin-inline: auto;
    max-width: var(--conteudo-max-padrao);
    transition: max-width var(--t) var(--easing);
  }
  .texto-aula :is(img, video, canvas, iframe, table) {
    max-width: 100%;
  }
  .texto-aula pre {
    overflow-x: auto;
  }
  :global(.texto-aula) {
    text-align: justify;
    text-align-last: start;
  }
  :global(.texto-aula p) {
    hyphens: auto;
    -webkit-hyphens: auto;
    -ms-hyphens: auto;
    overflow-wrap: break-word;
    word-break: normal;
  }
  :global(.texto-aula :is(h1,h2,h3,h4,h5,h6,li,pre,code,blockquote,figcaption)) {
    text-align: start;
    hyphens: manual;
  }
  .toggle-leitura {
    position: absolute;
    top: .5rem;
    right: .5rem;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .4rem .6rem;
    border: 1px solid currentColor;
    border-radius: var(--raio-m);
    background: transparent;
    cursor: pointer;
    font: 500 0.9rem/1.1 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  }
  .toggle-leitura .icone { transition: transform var(--t) var(--easing); }
  .handle-leitura {
    display: none;
    position: fixed;
    top: var(--handle-top);
    left: var(--handle-left);
    z-index: 9999;
    padding: .4rem .55rem;
    border: 1px solid currentColor;
    border-radius: var(--raio-m);
    background: var(--cor-superficie);
    cursor: pointer;
    font: 600 0.95rem/1 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    box-shadow: var(--sombra-1);
  }
  /* ===== Linha sob o título: número da aula e tempo de leitura (letra de máquina = assinatura) ===== */
  .texto-aula .meta-aula {
    margin: -0.5rem 0 2rem;
    font-family: var(--fonte-datilo);
    font-size: 0.95rem;
    color: var(--cor-texto-suave);
    text-align: start;
  }

  /* ===== Anterior / próxima no fim da aula ===== */
  .navegacao-aulas {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borda-escura);
  }
  .nav-aula {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 48%;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--borda-escura);
    border-radius: var(--raio-m);
    background: var(--cor-superficie);
    color: var(--cor-texto);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .nav-aula.proxima {
    margin-left: auto; /* sozinha (última aula tem só "anterior"; a 1ª, só "próxima") fica à direita */
    text-align: end;
  }
  .nav-aula.anterior { text-align: start; }
  .nav-rotulo {
    font-family: var(--fonte-ui);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--cor-texto-suave);
  }
  .nav-titulo {
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--cor-titulo);
  }
  .nav-aula:hover,
  .nav-aula:focus-visible {
    border-color: var(--cor-destaque);
  }
  .nav-aula:hover .nav-titulo { color: var(--cor-destaque); }
  .nav-aula:focus-visible {
    outline: 3px solid var(--cor-foco);
    outline-offset: 2px;
  }

  /* ===== Índice do curso: o <summary> só existe no celular ===== */
  .indice-curso > summary {
    display: none;
  }

  /* ===== Notas de margem (NotaDeMargem) em tela larga =====
     Abaixo de 1280px elas são blocos dentro do texto (ver o componente). */
  @media (min-width: 1280px) {
    /* Aula com notas à direita: reserva uma coluna de margem ao lado do texto, como num livro.
       --margem-notas também limita a largura da nota (NotaDeMargem). */
    :global(.texto-aula:has(.nota-de-margem[data-lado="direita"])) {
      --margem-notas: 14rem;
      max-width: calc(var(--conteudo-max-padrao) + var(--margem-notas));
      padding-right: var(--margem-notas);
    }
    :global(body.modo-leitura-ativo .texto-aula:has(.nota-de-margem[data-lado="direita"])) {
      max-width: calc(var(--conteudo-max) + var(--margem-notas));
    }

    /* Notas à ESQUERDA dividem espaço com o menu: só aparecem no modo leitura */
    :global(.conteudo-aula .nota-de-margem[data-lado="esquerda"] .nota) {
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--t) var(--easing);
    }
    body.modo-leitura-ativo :global(.conteudo-aula .nota-de-margem[data-lado="esquerda"] .nota) {
      opacity: 1;
      pointer-events: auto;
    }
  }
  body.modo-leitura-ativo .container-sala-de-aula {
    grid-template-columns: 0 1fr;
  }
  body.modo-leitura-ativo .menu-aulas {
    transform: translateX(-100%);
    pointer-events: none;
  }
  body.modo-leitura-ativo .handle-leitura {
    display: inline-flex;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-4px);
    transition:
      opacity var(--t) var(--easing),
      transform var(--t) var(--easing),
      visibility 0s linear var(--t);
  }
  body.modo-leitura-ativo.modo-leitura-handle-pronto .handle-leitura {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
    transition-delay: 0s, 0s, 0s;
  }
  body.modo-leitura-ativo .texto-aula {
    max-width: var(--conteudo-max, 70ch);
  }
  body.ml-preload .container-sala-de-aula,
  body.ml-preload .menu-aulas,
  body.ml-preload .conteudo-aula,
  body.ml-preload .handle-leitura,
  body.ml-preload :global(.conteudo-aula .nota-de-margem .nota) {
    transition: none !important;
  }
  body.ml-preload .handle-leitura {
    visibility: hidden;
  }
  .toggle-leitura:focus-visible,
  .handle-leitura:focus-visible {
    outline: 3px solid var(--cor-foco);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .container-sala-de-aula,
    .menu-aulas,
    .conteudo-aula,
    :global(.conteudo-aula .nota-de-margem .nota),
    .toggle-leitura,
    .handle-leitura,
    .toggle-leitura .icone {
      transition: none !important;
    }
  }

  /* ===== Responsivo: aulas no mobile ===== */
  @media (max-width: 768px) {
    /* Uma coluna: o menu deixa de esmagar a coluna de conteúdo */
    .container-sala-de-aula {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 0;
    }
    .menu-aulas {
      position: static;
      width: auto;
      height: auto;
      padding-inline: 20px; /* o mesmo respiro lateral do texto da aula */
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--borda-escura);
    }
    .texto-aula {
      max-width: 100%;
    }

    /* "Modo leitura" é um recurso de desktop (recolher a barra lateral);
       no mobile não há barra fixa, então escondemos os controles. */
    .toggle-leitura,
    .handle-leitura {
      display: none;
    }

    /* Índice recolhível: um "botão" com a posição da aula e o + que vira × */
    .indice-curso > summary {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--borda-escura);
      border-radius: var(--raio-m);
      background: var(--cor-superficie);
      font-family: var(--fonte-ui);
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .indice-curso > summary::-webkit-details-marker { display: none; }
    .indice-curso > summary::after {
      content: '+';
      margin-left: auto;
      font-size: 1.3rem;
      line-height: 1;
      transition: transform 0.3s ease;
    }
    .indice-curso[open] > summary::after { transform: rotate(45deg); }
    .indice-curso > summary:focus-visible {
      outline: 3px solid var(--cor-foco);
      outline-offset: 2px;
    }
    .indice-posicao {
      font-weight: 400;
      font-size: 0.9rem;
      color: var(--cor-texto-suave);
    }

    /* Anterior/próxima empilhadas */
    .navegacao-aulas { flex-direction: column; }
    .nav-aula { max-width: none; }

    /* Se o modo leitura foi herdado de uma sessão desktop, não deixa o menu
       sumir no mobile (senão o aluno fica sem acesso ao índice). */
    body.modo-leitura-ativo .container-sala-de-aula {
      grid-template-columns: 1fr;
    }
    body.modo-leitura-ativo .menu-aulas {
      transform: none;
      pointer-events: auto;
    }

    /* Justificado em coluna estreita abre "rios" de espaço entre as palavras */
    .conteudo-aula :global(.texto-aula) {
      text-align: left;
    }
  }
</style>
