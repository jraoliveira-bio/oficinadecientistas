---
import Layout from '~/layouts/Layout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.endsWith('/')
? import.meta.env.BASE_URL
: import.meta.env.BASE_URL + '/';

// Nº de aulas publicadas (no menu e fora de rascunho)
const totalAulas = (await getCollection('curso-escrita'))
  .filter(a => a.data.menu === true && !a.data.draft).length;
---

<Layout title="Cursos">
    <main>
        <section class="secao-manifesto">
            <div class="manifesto-conteudo">
                <h1>Ferramentas para o Pensamento Crítico</h1>
                <p>A Oficina de Cientistas reúne cursos gratuitos com as habilidades essenciais que raramente são ensinadas de forma estruturada na pós-graduação — da escrita científica à estatística e ao desenho experimental. Nossa biblioteca de conteúdo é 100% gratuita e está em constante expansão.</p>
            </div>
        </section>

        <section class="secao-vitrine-cursos">
            <h2>Nossos Cursos</h2>
            <div class="vitrine-grid">
                <a href={`${base}cursos/curso-escrita/`} class="card-curso-completo">
                    <img src={`${base}imagens/gatocard2.png`} alt="Ilustração para o curso de Escrita Científica">
                    <div class="card-curso-conteudo">
                        <h3>
                            <i class="fas fa-video"></i>
                            Escrita Científica
                        </h3>
                        <p class="card-curso-descricao">Aprenda a estruturar seus artigos, argumentar com clareza, e aumentar as chances de publicação em periódicos de prestígio.</p>
                        <div class="card-curso-meta">
                            <span class="tag-meta tag-status-rec">● EM GRAVAÇÃO</span>
                            <span class="tag-meta">{totalAulas} AULAS</span>
                            <span class="tag-meta">GRATUITO</span>
                        </div>
                    </div>
                </a>
            </div>
        </section>
    </main>
</Layout>