---
import Layout from '../../../layouts/Layout.astro';
import { Content } from '~/content/curso-escrita/introducao.mdx';
import Divider from '../../../components/Divider.astro';
import imagemDoDivisor from '~/../public/imagens/divider3.png';
import { getCollection } from 'astro:content';

// Grade curricular gerada a partir da coleção (aulas com menu:true, ordenadas)
const aulas = (await getCollection('curso-escrita'))
  .filter(a => a.data.menu === true && (import.meta.env.DEV || !a.data.draft))
  .sort((a, b) => (a.data.ordem ?? 999) - (b.data.ordem ?? 999));

const base = import.meta.env.BASE_URL.endsWith('/')
? import.meta.env.BASE_URL
: import.meta.env.BASE_URL + '/';

// "Ir para a primeira aula" segue a coleção (antes era fixo em aula01)
const primeiraAula = aulas[0] ? `${base}cursos/curso-escrita/${aulas[0].slug}/` : `${base}cursos/curso-escrita/`;

// Os ciclos do curso (os mesmos da introdução). Cada aula diz o seu com `ciclo: N` no
// frontmatter; a grade agrupa por eles. Ciclo sem aula aparece como "em preparação" — mostra
// o caminho inteiro do curso, não só o que já foi gravado. Outro curso define os seus ciclos.
const CICLOS = [
    { numero: 1, nome: 'As Fundações' },
    { numero: 2, nome: 'A Arquitetura' },
    { numero: 3, nome: 'A Reescrita' },
];
const grupos = CICLOS.map(ciclo => ({
    titulo: `Ciclo ${ciclo.numero}: ${ciclo.nome}`,
    aulas: aulas.filter(a => a.data.ciclo === ciclo.numero),
}));
const semCiclo = aulas.filter(a => !CICLOS.some(c => c.numero === a.data.ciclo));
if (semCiclo.length) grupos.push({ titulo: 'Outras aulas', aulas: semCiclo });
---

<Layout title="Curso de Escrita Científica" description="Escrita Científica: Da Estrutura ao Impacto — curso gratuito em aulas de vídeo e texto para pós-graduandos.">
    <main>
        <section class="secao-emblema">
            <img src={`${base}logo1.png`} alt="Logo Oficina de Cientistas" class="logo-emblema">
            <h1>Escrita Científica: Da Estrutura ao Impacto</h1>
            <Divider image={imagemDoDivisor.src} />
        </section>

        <div class="texto-introdutorio">
            <Content />
        </div>

        <div class="cta-container">
            <a href={primeiraAula} class="botao-principal">Ir para a Primeira Aula</a>
        </div>

        <section id="grade" class="secao-grade-curricular">
            <h2>Grade Curricular</h2>
            {grupos.map(grupo => (
            <div class="grade-ciclo">
            <h3 class="grade-ciclo-titulo">{grupo.titulo}</h3>
            {grupo.aulas.length === 0 && <p class="grade-ciclo-vazio">Aulas em preparação.</p>}
            {grupo.aulas.length > 0 && (
            <div class="acordeon-container">
                {grupo.aulas.map(aula => {
                    const icone = aula.data.tipo === 'texto' ? 'fas fa-align-left' : 'fas fa-video';
                    const titulo = aula.data.shortTitle ?? aula.data.title;
                    return (
                        <div class="acordeon-item">
                            <button class="acordeon-cabecalho" type="button" aria-expanded="false" aria-controls={`grade-${aula.slug}`}>
                                <span class="acordeon-titulo"><i class={icone} aria-hidden="true"></i> {titulo}</span>
                                <i class="fas fa-plus icone-acordeon" aria-hidden="true"></i>
                            </button>
                            {/* fechado = inert: o link de dentro não recebe Tab enquanto está invisível */}
                            <div class="acordeon-conteudo" id={`grade-${aula.slug}`} inert>
                                <p>{aula.data.description ?? 'Descrição em breve.'}</p>
                                <p><a href={`${base}cursos/curso-escrita/${aula.slug}/`}>Ir para a aula →</a></p>
                            </div>
                        </div>
                    );
                })}
            </div>
            )}
            </div>
            ))}
        </section>

        <div class="cta-container">
            <a href={primeiraAula} class="botao-principal">Ir para a Primeira Aula</a>
        </div>
    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const acordeonItems = document.querySelectorAll('.acordeon-item');
        acordeonItems.forEach(item => {
            const cabecalho = item.querySelector('.acordeon-cabecalho');
            cabecalho.addEventListener('click', () => {
                const conteudo = item.querySelector('.acordeon-conteudo');
                const isAberto = item.classList.contains('aberto');
                item.classList.toggle('aberto');
                // O ícone "+" gira 45° via CSS (.acordeon-item.aberto) e vira "×".
                cabecalho.setAttribute('aria-expanded', String(!isAberto));
                conteudo.inert = isAberto;
                conteudo.style.maxHeight = isAberto ? null : conteudo.scrollHeight + "px";
            });
        });
    });
</script>