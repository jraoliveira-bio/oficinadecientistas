---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogHeader from "@/components/BlogHeader.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import { formatDate } from "@/lib/blog-utils";
import { withBase } from "@/lib/url";

export async function getStaticPaths() {
  // Em ordem cronológica, para cada post saber o anterior (mais antigo) e o próximo (mais novo)
  const posts = (await getCollection("blog")).sort(
    (a, b) => a.data.dataPublicacao.getTime() - b.data.dataPublicacao.getTime()
  );
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, anterior: posts[i - 1] ?? null, proximo: posts[i + 1] ?? null },
  }));
}

const { post, anterior, proximo } = Astro.props;

// Render defensivo: evita tela vazia se houver problema no pipeline do MDX/rehype
let Render: any = null;
let headings: any[] = [];
try {
  const r = await post.render();
  Render = r?.Content ?? null;
  headings = r?.headings ?? [];
} catch (e) {
  console.error("[blog post render] falhou:", e);
}

const title = post.data.title ?? post.slug;
const description = post.data.summary ?? `Notas de desenvolvimento: ${title}`;
const dateLabel = formatDate(post.data.dataPublicacao);
const tagList = Array.isArray(post.data.tags) ? post.data.tags : [];
---

<BlogLayout title={`${title} — A Prancheta`} description={description}>
  <Fragment slot="header">
    <BlogHeader backHref={withBase("blog/")} />
  </Fragment>

  <article class="oc-ficha ficha-post">
    <!-- Cabeçalho da ficha: título, carimbo da data e etiquetas; a linha vermelha fecha o cabeçalho -->
    <header class="ficha-cabeca oc-ficha-linha">
      <h1>{title}</h1>
      <div class="ficha-meta">
        <time class="oc-carimbo" datetime={post.data.dataPublicacao.toISOString().slice(0, 10)}>{dateLabel}</time>
        {tagList.length > 0 && (
          <span class="ficha-tags">
            {tagList.map((t) => (
              <a class="oc-etiqueta" href={withBase(`blog/?tag=${encodeURIComponent(t)}`)} title={`Posts com a tag ${t}`}>{t}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="content">
      {
        Render
          ? <Render />
          : <p style="color: var(--oc-muted);">Não foi possível renderizar o conteúdo deste post. Veja o console do dev para detalhes.</p>
      }
    </div>

    <hr />
    {(anterior || proximo) && (
      <nav class="nav-posts" aria-label="Outros posts">
        {anterior && (
          <a class="nav-post anterior" href={withBase(`blog/${anterior.slug}/`)} rel="prev">
            <span class="nav-rotulo">← Post anterior</span>
            <span class="nav-titulo">{anterior.data.title}</span>
          </a>
        )}
        {proximo && (
          <a class="nav-post proximo" href={withBase(`blog/${proximo.slug}/`)} rel="next">
            <span class="nav-rotulo">Próximo post →</span>
            <span class="nav-titulo">{proximo.data.title}</span>
          </a>
        )}
      </nav>
    )}
    <p><a href={withBase("blog/")}>← Voltar ao blog</a></p>

    <section id="comments-root" data-post-uid={post.slug} style="margin-top: var(--oc-space-8);">
      <!-- Futuro:
      <script src="https://forum.seu-dominio/embedded/loader.js" defer></script>
      -->
    </section>
  </article>

  <Fragment slot="sidebar">
    <BlogSidebar>
      <p>Os bastidores da Oficina: registro das decisões e experimentos que não cabem na documentação formal.</p>
    </BlogSidebar>
  </Fragment>
</BlogLayout>

<style>
  .ficha-post { padding: var(--oc-space-6) var(--oc-space-6) var(--oc-space-4); }
  .ficha-cabeca {
    padding-bottom: var(--oc-space-4);
    margin-bottom: var(--oc-space-6);
  }
  .ficha-cabeca h1 { margin: 0 0 var(--oc-space-3); }
  .ficha-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--oc-space-2) var(--oc-space-3);
  }
  .ficha-tags { display: inline-flex; flex-wrap: wrap; gap: .4rem; }
  @media (max-width: 640px) {
    .ficha-post { padding: var(--oc-space-4); }
  }

  /* Anterior/próximo: o mesmo desenho do fim das aulas, com os tokens do blog */
  .nav-posts {
    display: flex;
    justify-content: space-between;
    gap: var(--oc-space-4);
    margin: var(--oc-space-6) 0;
  }
  .nav-post {
    display: flex;
    flex-direction: column;
    gap: var(--oc-space-1);
    max-width: 48%;
    padding: var(--oc-space-3) var(--oc-space-4);
    border: 1px solid var(--oc-border);
    border-radius: var(--oc-radius);
    color: var(--oc-fg);
    text-decoration: none;
  }
  .nav-post.proximo { margin-left: auto; text-align: end; }
  .nav-post:hover { border-color: var(--oc-titulo); text-decoration: none; }
  .nav-post:focus-visible { outline: 2px solid var(--oc-accent); outline-offset: 2px; }
  .nav-rotulo {
    font-size: var(--oc-fs-xxs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--oc-muted);
  }
  .nav-titulo {
    font-family: var(--oc-font-serif);
    font-weight: 700;
    color: var(--oc-titulo);
  }
  @media (max-width: 640px) {
    .nav-posts { flex-direction: column; }
    .nav-post { max-width: none; }
  }
</style>
