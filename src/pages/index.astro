---
import Layout from "../layouts/Layout.astro";
import HomeFeatured from "../components/home/HomeFeatured.astro";
import HomePrancheta from "../components/home/HomePrancheta.astro";
import HomeApresentacao from "../components/home/HomeApresentacao.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

// Nº de aulas publicadas (no menu e fora de rascunho) — evita número "chutado" no card
const totalAulas = (await getCollection("curso-escrita"))
  .filter((a) => a.data.menu === true && !a.data.draft).length;

const hero = {
  href: `${base}cursos/curso-escrita/`,
  imgSrc: `${base}imagens/gatocard2.png`,
  imgAlt: "Ilustração para o curso de escrita científica",
  label: "Curso em destaque",
  title: "Escrita Científica: Da Estrutura ao Impacto",
  description:
    "Um curso para transformar sua relação com a escrita acadêmica.",
  meta: `${totalAulas} aulas publicadas • em gravação`,
  cta: "Ver conteúdo do curso",
};

---

<Layout title="Home">
  <main class="home">
    <!-- O nome do site já está no header; este h1 é para leitores de tela e buscadores -->
    <h1 class="visualmente-oculto">Oficina de Cientistas</h1>

    <!-- Primeiro o conteúdo (o curso e a Prancheta); a apresentação da Oficina vem no fim -->
    <HomeFeatured hero={hero} />

    <HomePrancheta />

    <HomeApresentacao
      base={base}
      proposta="Fornecer um ciclo básico de formação para alunos da pós-graduação e fazer análises científicas de temas importantes."
    />
  </main>
</Layout>

<style>
  .home {
    padding-bottom: 2rem;
  }
</style>
